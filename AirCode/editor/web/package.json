{
  "name": "aircode-editor-web",
  "private": true,
  "version": "0.1.0",
  "description": "Веб-часть редактора AirCode: CodeMirror 6 в одном JS-файле для WebView",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=chrome80 --outfile=../src/main/assets/editor/editor.bundle.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
